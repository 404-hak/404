# Скопируйте в deploy/.env и заполните. Файл .env в git не попадает.
DOMAIN=404.example.ru
# ссылка для дежурных: https://$DOMAIN/?access=$ACCESS_TOKEN   (python3 -c "import secrets;print(secrets.token_urlsafe(32))")
ACCESS_TOKEN=
# токен буёв: Authorization: Bearer $BUOY_TOKEN
BUOY_TOKEN=
# лучше — свой токен у каждого буя (тогда общий BUOY_TOKEN не нужен): b01:токен1,b02:токен2
BUOY_TOKENS=
# тревоги — ещё и в Telegram: бот от @BotFather и чат дежурного (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_URL=https://404.example.ru
# на настоящих данных демо выключено: «Сбросить» стирает базу и улики
DEMO=0
SIM_HEARTBEAT=0
# сколько хранить звук без тревоги, часов (звук тревог хранится всегда)
CLIP_RETENTION_HOURS=24
VITE_YANDEX_MAPS_KEY=
